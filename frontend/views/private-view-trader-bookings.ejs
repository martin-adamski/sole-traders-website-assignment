<%- include('partials/header') %>

<h1>Bookings</h1>

<form action="/view-bookings" method="GET">
    <label>Booking Status</label>
    <select name="status">
        <option value="Pending" <%= currentFilter === 'Pending' ? 'selected' : '' %>>Pending</option>
        <option value="Confirmed" <%= currentFilter === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
        <option value="Rejected" <%= currentFilter === 'Rejected' ? 'selected' : '' %>>Rejected</option>
    </select>
    <button type="submit">Apply Filter</button>
</form>

<h3><%= currentFilter %> Bookings:</h3>
<% if (bookings.length === 0) { %>
    <p>No <%= currentFilter %> bookings found.</p>
<% } else { %>
     <ul>
        <% bookings.forEach(booking => { %>
            <li>
                <p>Service Name: <%= booking.service_name %></p>
                <p>Service Description: <%= booking.service_description %></p>
                <p>Client Description: <%= booking.client_description %></p>
                <p>Job Date: <%= booking.job_date %></p>
                <p>Job Start Time: <%= booking.job_start_time %></p>
                <p>Price Type: <%= booking.price_type %></p>
                <p>Base Price: <%= booking.base_price %></p>
            </li>

            <% if (currentFilter === 'Pending') { %>
            <form action="/update-booking" method="POST">
                <input type="hidden" name="bookingId" value="<%= booking.booking_id %>">
                <input type="hidden" name="newStatus" value="Confirmed">

                <button type="submit">Confirm</button>
            </form>

            <form action="/update-booking" method="POST">
                <input type="hidden" name="bookingId" value="<%= booking.booking_id %>">
                <input type="hidden" name="newStatus" value="Rejected">

                <button type="submit">Reject</button>
            </form>
            <% } %>
            <br>
        <% }); %>
    </ul>
 <% } %>