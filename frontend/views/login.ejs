<%- include('partials/header') %>

<% if (locals.message) { %>
    <p id="flash-msg" class="help <%= message.type %>" style="font-weight: bold; margin-bottom: 10px;">
        <%= message.text %>
    </p>
<% } %>

<% if (locals.errorMessage) { %>
    <p id="error-msg" class="help is-danger" style="font-weight: bold; margin-bottom: 10px;">
        <%= errorMessage %>
    </p>
<% } %>

<h1>Login</h1>
<form action="/login" method="post">

    <div>
        <label for="uname">Username</label>
        <input type="text" name="username" id="uname" placeholder="Enter username" required>
    </div>
    
    <div>
        <label for="upass">Password</label>
        <input type="password" name="userpass" id="upass" placeholder="Enter password" required>
    </div>

    <button type="submit">Submit</button>
</form>

<%- include('partials/footer') %>
