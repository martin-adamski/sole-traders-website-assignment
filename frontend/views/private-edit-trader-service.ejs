<%- include('partials/header') %>

<% if (locals.message) { %>
    <p id="flash-msg" class="notification <%= message.type %> m-3 py-3">
        <%= message.text %>
    </p>
<% } %>

<div class="box m-3">
    <p class="title is-3 mb-4 mt-3 ml-2">Edit Service</p>
    
    <form action="/edit-service/<%= serviceId %>" method="POST">
        <input type="hidden" name="trader_id" value="<%= traderId %>">
        
        <div class="field mb-2 mt-1 ml-2">
            <label class="label" for="stitle">Title:</label>
            <div class="control">
                <input class="input" type="text" name="title" id="stitle" value="<%= service.title %>" required>
            </div>
        </div>

       <div class="field mb-2 mt-1 ml-2">
            <label class="label" for="sdescription">Description:</label>
            <div class="control">
                <textarea class="textarea" name="description" id="sdescription" rows="3" required><%= service.description %></textarea>
            </div>
        </div>
    
        <div class="field mb-2 mt-1 ml-2">
            <label class="label" for="sbase_price">Base Price:</label>
            <div class="control">
                <input class="input" type="number" name="base_price" id="sbase_price" step="0.01" value="<%= service.base_price %>" required>
            </div>
        </div>
    
        <div class="field mb-2 mt-1 ml-2">
            <label class="label" for="sprice_type">Price Type:</label>
            <div class="control">
                <div class="select">
                    <select name="price_type" id="sprice_type" required>
                        <option value="Fixed" <%= service.price_type === 'Fixed' ? 'selected' : '' %>>Fixed</option>
                        <option value="Hourly" <%= service.price_type === 'Hourly' ? 'selected' : '' %>>Hourly</option>
                    </select>
                </div>
            </div>
        </div>

        <button class="button is-dark mb-2 mt-4 ml-2" type="submit">Confirm</button>
        <a class="button is-link mb-2 mt-4 ml-2" href="/view-services/">Cancel</a>
    </form>
</div>

<%- include('partials/footer') %>