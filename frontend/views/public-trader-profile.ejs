<%- include('partials/header') %>

<% if (locals.message) { %>
    <p id="flash-msg" class="notification <%= message.type %> m-3 py-3">
        <%= message.text %>
    </p>
<% } %>

<div class="box m-3">
    <a class="subtitle has-text-link is-6" href="/directory">&larr; Back to Directory</a>

    <p class="title is-3 mb-4 mt-3 ml-2"><%= trader.full_name %></p>
    <p class="subtitle is-5 mb-2 mt-4 ml-2"><strong><%= trader.trade_type %></strong> in <%= trader.region %></p>
    <p class="subtitle is-6 mb-2 mt-2 ml-2"><%= trader.bio %></p>
    <p class="subtitle is-italic is-6 mb-2 mt-4 ml-2">Average Rating: <%= trader.average_rating %></p>
</div>

<div class="box m-3">

    <form action="/submit-rating" method="POST">
    <input type="hidden" name="traderId" value="<%= traderId %>">

    <div class="field">
        <label class="label mb-2 mt-4 ml-2" for="rating">Rate Trader:</label>
            <div class="control">
                <div class="select is-fullwidth mb-2 ml-2">
                    <select name="rating" id="rating" required>
                        <option value="5">5</option>
                        <option value="4">4</option>
                        <option value="3">3</option>
                        <option value="2">2</option>
                        <option value="1">1</option>
                    </select>
                </div>
            </div>
    </div>
    
    <button class="button is-dark mb-2 mt-1 ml-2" type="submit">Submit</button>
</form>

</div>

<hr>

<% if (services.length === 0) { %>
    <div class="box m-3">
        <p class="subtitle is-5 mb-2 mt-4 ml-2">No services listed.</p>
    </div>
<% } else { %>
    <% services.forEach(service => { %>
        <div class="box m-3">
            <p class="title is-4 mb-2 mt-2 ml-2"><%= service.title %> (£<%= service.base_price %> - <%= service.price_type %>)</p>
            <p class="subtitle is-5 mb-2 mt-2 ml-2"><%= service.description %></p>
            <% if (user.role !== 'Trader') { %>
                <a class="button is-link mb-2 mt-3 ml-2" href="/services/<%= service.id %>/book">Book Service</a>
            <% } %>
        </div>
    <% }); %>
<% } %>

<%- include('partials/footer') %>