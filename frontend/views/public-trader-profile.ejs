<%- include('partials/header') %>

<a href="/directory">&larr; Back to Directory</a>

<% if (locals.message) { %>
    <p id="flash-msg" class="help <%= message.type %>" style="font-weight: bold; margin-bottom: 10px;">
        <%= message.text %>
    </p>
<% } %>

<h1><%= trader.full_name %></h1>
<p><strong><%= trader.trade_type %></strong> in <%= trader.region %></p>

<p><%= trader.bio %></p>
<p>Average Rating: <%= trader.average_rating %></p>

<form action="/submit-rating" method="POST">
    <input type="hidden" name="traderId" value="<%= traderId %>">

    <div>
        <label for="rating">Rate Trader:</label>
            <select name="rating" id="rating" required>
            <option value="5">5</option>
            <option value="4">4</option>
            <option value="3">3</option>
            <option value="2">2</option>
            <option value="1">1</option>
        </select>
    </div>
    
    <button type="submit">Submit</button>
</form>

<hr>

<h2>Services</h2>

<% if (services.length === 0) { %>
    <p>No services listed.</p>
<% } else { %>
    <ul>
        <% services.forEach(service => { %>
            <li>
                <h3><%= service.title %> (£<%= service.base_price %>)</h3>
                <p><%= service.description %></p>
                <% if (user.role !== 'Trader') { %>
                    <a href="/services/<%= service.id %>/book">Book this service</a>
                <% } %>
            </li>
            <br>
        <% }); %>
    </ul>
<% } %>

<%- include('partials/footer') %>