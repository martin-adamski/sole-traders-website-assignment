<%- include('partials/header') %>

<hr>

<% if (locals.message) { %>
    <p id="flash-msg" class="notification <%= message.type %> m-3 py-3">
        <%= message.text %>
    </p>
<% } %>

<h1>Manage Services</h1>
<a href="/add-service/">Add Service</a>

<% if (services.length === 0) { %>
    <p>No services found.</p>
<% } else { %>
    <ul>
        <% services.forEach(service => { %>
            <li>
                <p><%= service.title %></p>
                <p><%= service.description %></p>
                <p><%= service.base_price %></p>
                <p><%= service.price_type %></p>
            </li>

            <a href="/edit-service/<%= service.id %>">Edit Service</a>
            
            <form action="/delete-service/<%= service.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete the service')">
                <button type="submit">Delete Service</button>
            </form>

            <br>
        <% }); %>
    </ul>
<% } %>

<%- include('partials/footer') %>