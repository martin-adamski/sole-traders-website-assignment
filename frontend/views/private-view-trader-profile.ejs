<%- include('partials/header') %>

<div class="box m-3">
    <p class="title is-3 mb-4 mt-3 ml-2">Your Trader Profile</p>    
    <p class="subtitle is-5 mb-2 mt-3 ml-2">Full Name: <strong><%= profile.full_name %></strong></p>
    <p class="subtitle is-5 mb-2 mt-3 ml-2">Trade Type: <strong><%= profile.trade_type %></strong></p>
    <p class="subtitle is-5 mb-2 mt-3 ml-2">City: <strong><%= profile.region %></strong></p>
    <p class="subtitle is-5 mb-2 mt-3 ml-2">Bio: <strong><%= profile.bio %></strong></p>
    <p class="subtitle is-5 mb-2 mt-3 ml-2">Availability Description: <strong><%= profile.availability %></strong></p>
    
    <a class="button is-link mb-2 mt-4 ml-2" href="/edit-profile/">Edit Profile</a>

</div>

<%- include('partials/footer') %>