<%- include('partials/header') %>

<div class="box has-text-centered m-3">
    <div class="title is-3">Create an account</div>

    <form action="/register" method="post">
        <div class="field">
            <input class="input" type="text" name="useremail" id="uemail" placeholder="Email" required>
        </div>
    
        <div class="field">
            <input class="input" type="password" name="userpass" id="upass" placeholder="Password" required>
        </div>

        <div class="field">
            <input class="input" type="text" name="username" id="uname" placeholder="Username" required>
        </div>

        <div class="field">
            <input class="input" type="text" name="userfullname" id="ufullname" placeholder="Full name" required>
        </div>

        <div class="control">
            <p class="subtile is-5 has-text-centered mt-4">Do you wish to register as a client or a trader?</p>
            
            <label class="radio" for="userChoice1">
                <input type="radio" id="userChoice1" name="userrole" value="client" required>
                Client
            </label>

            <label class="radio" for="userChoice2">
                <input type="radio" id="userChoice2" name="userrole" value="trader" required>
                Trader
            </label>
        </div>

        <button class="button is-dark mt-5" type="submit">Submit</button>
    </form>
</div>


<%- include('partials/footer') %>