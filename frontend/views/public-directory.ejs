<%- include('partials/header') %>

<div class="box m-3">
    <form action="/directory" method="GET">
        <div class="columns is-vcentered"> 
            
            <div class="column is-one-quarter m-3">
                <p class="title is-3"><%= title %></p>
                <p class="subtitle is-6"><%= traders.length %> active traders</p>
            </div>

            <div class="column is-one-quarter m-3">
                <div class="field">
                    <label class="label">Trade Type</label>
                    <div class="control">
                        <div class="select is-fullwidth"> 
                            <select name="tradeTypeChoice">
                                <% types.forEach( type => { %>
                                    <option value="<%= type %>" <%= currentFilter.type === type ? 'selected' : '' %>>
                                        <%= type %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="column is-one-quarter m-2">
                <div class="field">
                    <label class="label">Region</label>
                    <div class="control">
                        <div class="select is-fullwidth">
                            <select name="regionChoice">
                                <% regions.forEach( region => { %>
                                    <option value="<%= region %>" <%= currentFilter.region === region ? 'selected' : '' %>>
                                        <%= region %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="column is-one-quarter m-3">
                <div class="field is-grouped mt-5"> 
                    <div class="control">
                        <button class="button is-dark" type="submit">Apply Filter</button>
                    </div>
                    <div class="control">
                        <a href="/directory" class="button is-dark">Reset Filter</a>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

<% if (traders.length === 0) { %>
    <div class="box m-3">
        <p class="title is-3 mb-4 mt-3 ml-2">No traders found.</p>
    </div>
<% } else { %> 
        <% traders.forEach(trader => { %>
            <div class="box m-3">
                <a class="title has-text-link is-3 mb-4 mt-3 ml-2" href="/traders/<%= trader.user_id %>"><%= trader.full_name %></a>
                <p class="subtitle is-5 mb-2 mt-4 ml-2"><%= trader.trade_type %> in <%= trader.region %></p>
                <p class="subtitle is-6 mb-2 mt-2 ml-2">Average Rating: <%= trader.average_rating %></p>
            </div>
        <% }); %> 
<% } %>

<hr>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script type="application/json" id="chartData">
    {
        "monthly": <%- monthlyBookings %>,
        "popularity": <%- tradePopularity %>
    }
</script>

<div class="box m-3">
    <div class="columns is-desktop m-3">
        <div class="column is-half">
            <canvas id="monthlyChart"></canvas>
        </div>
        <div class="column is-half m-3">
            <canvas id="popularityChart"></canvas>
        </div>
    </div>
</div>

<script>
    try {
        const rawData = document.getElementById('chartData').textContent;
        const data = JSON.parse(rawData);

        const makeChart = (id, label, arr, xKey, yKey, color) => {
            if (!arr || arr.length === 0) return;
            
            new Chart(document.getElementById(id), {
                type: 'bar',
                data: {
                    labels: arr.map(d => d[xKey]),
                    datasets: [{ 
                        label: label,
                        data: arr.map(d => d[yKey]),
                        backgroundColor: color,
                    }],
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }, 
                    },
                },
            });
        };

        makeChart('monthlyChart', 'Bookings per Month', data.monthly, 'month_name', 'count', '#36A2EB');
        makeChart('popularityChart', 'Bookings by Trade', data.popularity, 'trade_type', 'count', '#4BC0C0');

    } catch (err) {
        console.error("Chart error:", err.message);
    }
</script>

<%- include('partials/footer') %>