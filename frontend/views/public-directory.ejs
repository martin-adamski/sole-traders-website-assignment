<%- include('partials/header') %>

<h1><%= title %></h1>
<p><%= traders.length %> active traders</p>

<form action="/directory" method="GET">
    <label>Trade Type</label>
    <select name="tradeTypeChoice">
        <% types.forEach( type => { %>
            <option value="<%= type %>" <%= currentFilter.type === type ? 'selected' : '' %>>
                <%= type %>
            </option>
        <% }) %>
    </select>

    <label>Region</label>
    <select name="regionChoice">
        <% regions.forEach( region => { %>
            <option value="<%= region %>" <%= currentFilter.region === region ? 'selected' : '' %>>
                <%= region %>
            </option>
         <% }) %>
    </select>

    <button type="submit">Apply Filters</button>
</form>

<form action="/directory" method="GET">
    <button type="submit">Reset Filters</button>
</form>

<% if (traders.length === 0) { %>
    <p>No traders found.</p>
<% } else { %>
    <ul>
        <% traders.forEach(trader => { %>
            <li>
                <h3><a href="/traders/<%= trader.user_id %>"><%= trader.full_name %></a></h3>
                <p><%= trader.trade_type %> in <%= trader.region %></p>
                <p>Average Rating: <%= trader.average_rating %></p>
            </li>
            <br>
        <% }); %>
    </ul>
<% } %>

<%- include('partials/footer') %>