<%- include('partials/header') %>

<h1>Request Booking</h1>
<h2><%= service.title %> with <%= trader.name %></h2>
<p>Price: £<%= service.base_price %></p>

<hr>

<% if (locals.successfulMessage) { %>
    <p id="success-msg" class="help is-success" style="font-weight: bold; margin-bottom: 10px;">
        <%= successfulMessage %>
    </p>
<% } %>

<% if (locals.errorMessage) { %>
    <p id="error-msg" class="help is-danger" style="font-weight: bold; margin-bottom: 10px;">
        <%= errorMessage %>
    </p>
<% } %>

<form action="/services/<%= service.id %>/book" method="POST">
    <input type="hidden" name="trader_id" value="<%= trader.id %>">
    <input type="hidden" name="client_user_id" value="<%= user.id %>">

    <div>
        <label for="cname">Your Name:</label>
        <input type="text" name="client_name" id="cname" value="<%= user.full_name %>" required>
    </div>

    <div>
        <label for="cemail">Your Email:</label>
        <input type="email" name="client_email" id="cemail" value="<%= user.email %>" required>
    </div>
    
    <div>
        <label for="date">Date:</label>
        <input type="date" name="job_date" id="date" min="2026-01-01" max="2028-01-01"required>
    </div>
    
    <div>
        <label for="start_time">Start Time:</label>
        <input type="time" name="job_start_time" id="start_time" required>
    </div>
    
    <div>
        <label for="description">Job Description:</label>
        <textarea name="job_description" rows="5" id="description" required></textarea>
    </div>

    <button type="submit">Confirm Booking</button> 
    or <a href="/traders/<%= trader.id %>">Cancel</a>

</form>

<%- include('partials/footer') %>