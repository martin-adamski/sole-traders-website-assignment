<%- include('partials/header') %>

<h1>Request Booking</h1>
<h2><%= service.title %> with <%= trader.name %></h2>
<p>Price: £<%= service.base_price %></p>

<hr>
<!-- need to reconcile whether a user has to have an account to create a booking or not-->
<form action="/services/<%= service.id %>/book" method="POST">
    <input type="hidden" name="trader_id" value="<%= trader.id %>">
    <input type="hidden" name="client_user_id" value="<%= user.id %>">
    
    <% if (locals.successfulMessage) { %>
        <p id="success-msg" class="help is-success" style="font-weight: bold; margin-bottom: 10px;">
            <%= successfulMessage %>
        </p>
    <% } %>

    <p>
        <label>Your Name:</label><br>
        <input type="text" name="client_name" value="<%= user.full_name %>" required>
    </p>

    <p>
        <label>Your Email:</label><br>
        <input type="email" name="client_email" value="<%= user.email %>" required>
    </p>
    
    <p>
        <label>Date:</label><br>
        <input type="date" name="job_date" required>
    </p>
    
    <p>
        <label>Start Time:</label><br>
        <input type="time" name="job_start_time" required>
    </p>
    
    <p>
        <label>Notes:</label><br>
        <textarea name="job_description" rows="5" required></textarea>
    </p>

    <button type="submit">Confirm Booking</button> 
    or <a href="/traders/<%= trader.id %>">Cancel</a>

</form>

<%- include('partials/footer') %>